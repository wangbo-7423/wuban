# =====================================================================
# AI 伴学 · 后端环境变量
# 复制为 backend/.env；本地起 PostgreSQL 见 docker-compose.yml
# =====================================================================

# ── 应用 / 调试 ───────────────────────────────────────────
APP_NAME=AI 伴学
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── 数据库（必填；强约束：必须 PostgreSQL）────────────────
# 本地用 docker compose up -d 起一个 pg 容器即可
DATABASE_URL=postgresql+psycopg2://aitutor:aitutor@127.0.0.1:5433/aitutor
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ── 鉴权（必填：JWT_SECRET ≥ 32 字节）────────────────────
# 生产环境务必用 KMS/密钥管理；开发可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-please-use-a-32+-byte-key-0001
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_ISSUER=ai-tutor

# ── 大模型（GLM 5.3 Flash）────────────────────────────
# 去 https://open.bigmodel.cn 申请；⚠️ 真实 key 只放 .env（已 gitignore），这里永远放占位符
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_SEC=60
GLM_ENABLE_THINKING=true
# 推理深度：low / high / max（GLM-5.2+ 生效，5.3 / 5.3-flash 仅这三档）
# glm-5.3 系列强制思考关不掉，且思考 token 计入 GLM_MAX_TOKENS、优先于正文消耗；
# 不设时平台默认 max（深度推理），是首字延迟和「想得多、输出少」的主因。
# 伴学对话推荐 low；数学推导若质量下滑改 high。
GLM_REASONING_EFFORT=low
GLM_MAX_TOKENS=4096
GLM_TEMPERATURE=0.7

# ── 跨域（JSON 数组 或 逗号分隔）────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── MCP / 工具 / 检索（可选；空则禁用）──────────────────
MILVUS_URI=
REDIS_URL=
MINIO_ENDPOINT=
HIGRESS_GATEWAY=
ENABLE_WEB_SEARCH=false
# web_search 后端（enable_web_search=true 时生效）：
#   默认三级链 Tavily(配 key 才启用) → Bing 中国区抓取(零配置，国内最稳) → ddgs(需 pip install ddgs)
# WEB_SEARCH_BACKEND=auto                 # 仅影响 ddgs 的引擎选择；一般不用动
TAVILY_API_KEY=
ENABLE_CALCULATOR=true
# 代码执行（工科微项目线核心）。默认开：学生贴仿真/脚本 → AI 跑一遍给审阅式反馈。
# 沙箱禁网络+禁系统命令+硬超时，仅适合本地/受信环境；多租户生产请关闭并改用容器隔离。
ENABLE_CODE_RUNNER=true
# CODE_RUNNER_TIMEOUT=15.0                 # 单次代码执行硬超时（秒）

# ── 文件上传（图片，沿用 research-assistant-agent 安全范式）──
# 以下三项均有默认值，一般无需改；列在此处便于按需调整
# UPLOAD_DIR=backend/uploads-image          # 图片落盘目录（绝对路径）
# MAX_IMAGE_BYTES=10485760                 # 单图上限（字节，默认 10MB）
# ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp   # MIME 白名单，逗号分隔

# ── MCP 记忆服务（官方 server-memory，本地安装于 mcp_servers/）──
ENABLE_MCP_MEMORY=true
# MCP_MEMORY_DIR=data/memory            # 每个用户一个 user_{id}.jsonl
# MCP_MEMORY_CALL_TIMEOUT=12.0          # 单次 MCP 调用超时（秒）
